{
  "name": "@seangle/dsh-remember",
  "version": "0.1.1",
  "description": "Portable plain-file memory for the DeepSeek Harness: facts, notes, stable memo IDs, lexical search, and a session snapshot.",
  "license": "Apache-2.0",
  "author": "Esensats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esensats/agents-remember.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/Esensats/agents-remember/tree/main/packages/dsh#readme",
  "bugs": {
    "url": "https://github.com/Esensats/agents-remember/issues"
  },
  "keywords": ["dsh-plugin", "memory", "persistent-memory"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@seangle/remember-core": "^0.1.0",
    "@seangle/remember-migrators": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
